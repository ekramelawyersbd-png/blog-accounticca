# Cloudflare Pages Edge Security & Cache Headers
# Mirrors the Express origin tiered CDN-Cache-Control policy

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=300, stale-while-revalidate=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: max-age=3600, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: max-age=3600, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: max-age=3600, stale-while-revalidate=86400

/api/*
  Cache-Control: private, no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/admin/*
  Cache-Control: private, no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
