rules_version = '2';

// Target Named Firestore Database:
//   Project ID: gen-lang-client-0396222608
//   Database ID: ai-studio-accounticcainsig-89414606-29ba-4643-944b-e0ac41725d03
// Deploy explicitly to the named database target configured in firebase.json / console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isAllowlistedAdminEmail() {
      return hasVerifiedEmail()
        && request.auth.token.email.lower() in [
          'hmekram@gmail.com',
          'ekram.elawyersbd@gmail.com',
          'ekram@elawyersbd.com',
          'admin@erpforu.com',
          'superadmin@erpforu.com'
        ];
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || isAllowlistedAdminEmail()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isDocOwner(data) {
      return isSignedIn() && data != null && (
        (data.userId is string && data.userId == request.auth.uid)
        || (data.uid is string && data.uid == request.auth.uid)
        || (data.userUid is string && data.userUid == request.auth.uid)
        || (
          hasVerifiedEmail() && (
            (data.email is string && data.email.lower() == request.auth.token.email.lower())
            || (data.userEmail is string && data.userEmail.lower() == request.auth.token.email.lower())
            || (data.recipientEmail is string && data.recipientEmail.lower() == request.auth.token.email.lower())
            || (data.primaryRecipient is string && data.primaryRecipient.lower() == request.auth.token.email.lower())
            || (data.clientEmail is string && data.clientEmail.lower() == request.auth.token.email.lower())
          )
        )
      );
    }

    // -------------------------------------------------------------------------
    // RESTRICTED PII & BACKEND-MANAGED COLLECTIONS (NO PUBLIC ACCESS)
    // Public submissions MUST go through validated Express backend endpoints
    // (Turnstile + Zod + rate limiting + Firebase Admin SDK).
    // -------------------------------------------------------------------------
    match /contact_messages/{msgId} {
      allow read, write: if isAdmin();
    }

    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if isAdmin();
    }

    match /notion_sync_queue/{jobId} {
      allow read, write: if isAdmin();
    }

    match /admin_revoked_sessions/{jti} {
      allow read, write: if isAdmin();
    }

    match /admin_revocation_watermarks/{emailKey} {
      allow read, write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /consultation_appointments/{docId} {
      allow read, write: if isAdmin();
    }

    match /r2MaterialUploads/{docId} {
      allow read, write: if isAdmin();
    }

    match /r2MaterialAccessLogs/{docId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // OWNER-SCOPED USER PROFILES, BOOKINGS, PAYMENTS & PORTAL DOCUMENTS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && (!('role' in incoming()) || incoming().role in ['client', 'user', 'subscriber', 'student'])
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && (!('role' in incoming()) || incoming().role == resource.data.get('role', incoming().role))
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /appointments/{appointmentId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(appointmentId)
        && incoming().userId == request.auth.uid
        && incoming().clientName is string
        && incoming().email is string
      );
      allow update: if isAdmin() || (
        isDocOwner(resource.data)
        && (!('userId' in incoming()) || incoming().userId == resource.data.userId)
      );
      allow delete: if isAdmin();
    }

    match /emailNotifications/{notificationId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(notificationId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /user_purchases/{purchaseId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(purchaseId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(paymentId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow write: if isAdmin();
    }

    match /client_documents/{docId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(docId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDocOwner(resource.data);
    }

    match /workspace_documents/{docId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(docId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDocOwner(resource.data);
    }

    match /taxCalculations/{calcId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(calcId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDocOwner(resource.data);
    }

    match /favorites/{favoriteId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(favoriteId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDocOwner(resource.data);
    }

    match /job_applications/{appId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(appId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDocOwner(resource.data);
    }

    match /jobApplications/{appId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(appId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDocOwner(resource.data);
    }

    match /training_admissions/{admissionId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(admissionId)
        && incoming().userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /calculation_email_reports/{reportId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(reportId)
        && incoming().referenceId is string
        && incoming().toolId is string
        && (!('userId' in incoming()) || incoming().userId == request.auth.uid)
      );
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // LMS COLLECTIONS (OWNER / STUDENT / ADMIN SCOPED)
    // -------------------------------------------------------------------------
    match /lms_portal_config/{configId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /lms_courses/{courseId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /lms_enrollments/{enrollmentId} {
      allow get, list: if isAdmin() || (isSignedIn() && (enrollmentId == request.auth.uid || isDocOwner(resource.data)));
      allow create, update: if isAdmin() || (isSignedIn() && enrollmentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /userCourses/{docId} {
      allow get, list: if isAdmin() || (isSignedIn() && (docId.matches(request.auth.uid + '_.*') || isDocOwner(resource.data)));
      allow write: if isAdmin();
    }

    match /lms_progress/{progressId} {
      allow get, list: if isAdmin() || (isSignedIn() && (progressId == request.auth.uid || isDocOwner(resource.data)));
      allow create, update: if isAdmin() || (isSignedIn() && (progressId == request.auth.uid || incoming().userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /lms_attempts/{attemptId} {
      allow get, list: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /lms_certificates/{certificateId} {
      allow get, list: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
      allow write: if isAdmin();
    }

    match /lms_exam_results/{resultId} {
      allow get, list: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /lms_audit_logs/{logId} {
      allow get, list: if isAdmin() || (isSignedIn() && isDocOwner(resource.data));
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // PUBLIC CATALOGS & NON-PII DISCUSSIONS
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow get, list: if true;
      allow create: if isValidId(commentId)
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 5000
        && incoming().articleId is string
        && incoming().articleId.size() <= 256;
      allow update: if isAdmin() || (
        isValidId(commentId)
        && (
          (isSignedIn() && resource.data.userId == request.auth.uid)
          || (incoming().diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'updatedAt']))
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /workspace_tool_signings/{signingId} {
      allow get, list: if isAdmin() || isDocOwner(resource.data);
      allow create: if isSignedIn()
        && isValidId(signingId)
        && incoming().toolId is string
        && incoming().toolId.size() <= 128;
      allow update, delete: if isAdmin();
    }

    match /compliance_analytics_events/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId)
        && incoming().eventName is string
        && incoming().eventName.size() <= 128;
      allow update, delete: if isAdmin();
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Strict default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
