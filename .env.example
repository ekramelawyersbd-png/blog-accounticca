# ==============================================================================
# ACCOUNTICCA — ENVIRONMENT VARIABLE TEMPLATE (DO NOT COMMIT REAL SECRETS)
# ==============================================================================
# Required variables are uncommented below.
# Optional third-party integration secrets are commented out so deployment does
# not block on unused integrations; uncomment and set them in your environment
# only if you want to enable those specific integrations.

# Gemini API Key (Provided automatically by AI Studio runtime)
GEMINI_API_KEY=

# Core Application URL (Used for signed one-click newsletter unsubscribe links)
APP_URL=https://blog.accounticca.com

# Firebase & Named Firestore Database
FIREBASE_PROJECT_ID=gen-lang-client-0361533735
BLOG_FIREBASE_PROJECT_ID=blogaccounticca
FIRESTORE_DATABASE_ID=ai-studio-accounticcainsig-89414606-29ba-4643-944b-e0ac41725d03
# Optional: Server Admin SDK service account credentials (if not using GCP ADC)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Admin Authentication & Session Management
# Comma-separated allowlist of verified admin Google/Firebase emails
ADMIN_ALLOWED_EMAILS=hmekram@gmail.com,ekram.elawyersbd@gmail.com,ekram@elawyersbd.com,admin@erpforu.com,superadmin@erpforu.com
ADMIN_DISPLAY_NAME=Adv. Ekram Hossain
# Optional: Persistent session signing secret (auto-generated per process if unset)
# ADMIN_SESSION_SECRET=
# Optional: Password-based admin login hash (Google OAuth admin sign-in works without this)
# ADMIN_PASSWORD_HASH=
# Optional: Default email prefill on admin login form
# VITE_ADMIN_LOGIN_EMAIL=

# Optional: Signed Security & Unsubscribe Secrets (auto-fallback if unset)
# TURNSTILE_PROOF_SECRET=
# UNSUBSCRIBE_HMAC_SECRET=

# Cloudflare Turnstile Human Verification
TURNSTILE_HOSTNAMES=blog.accounticca.com,accounticca.com,localhost
# Optional: Set to enable live Cloudflare Turnstile verification
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SECRET=

# Cloudflare Edge Zone Cache Purge & Web Analytics (Optional)
# Set Zone ID + Scoped API Token (Zone:Cache Purge) to enable Admin one-click edge purge
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# Set Web Analytics beacon token from Cloudflare Dashboard -> Web Analytics to enable client telemetry
# VITE_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional: Notion Private API Integration (Server-Side Only — NEVER prefix with VITE_)
# NOTION_TOKEN=
# NOTION_CONTACT_DB_ID=
# NOTION_NEWSLETTER_DB_ID=

# Brevo Transactional Email API & SMTP Relay
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SENDER_NAME=ACCOUNTICCA x E-Lawyers
BREVO_SENDER_EMAIL=admin@blog.accounticca.com
SUPPORT_EMAIL=ekram@accounticca.com
BREVO_SUPPORT_EMAIL=ekram@accounticca.com
CAREER_HR_EMAIL=ekram@elawyersbd.com
# Optional: Set API key or SMTP credentials to enable Brevo delivery
# BREVO_API_KEY=
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=

# Cloudflare R2 Object Storage (S3-Compatible API for LMS Course Materials)
R2_BUCKET_NAME=elawyers-lms-assets
R2_SIGNED_URL_TTL_SECONDS=3600
# Optional: Set to switch LMS storage from local fallback to Cloudflare R2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# UddoktaPay Payment Gateway (Automated bKash, Nagad, Rocket, Upay, Cards)
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com/api
UDDOKTAPAY_HOSTED_URL=https://sandbox.uddoktapay.com
# Optional: Set live/sandbox keys to override default sandbox configuration
# UDDOKTAPAY_API_KEY=
# VITE_UDDOKTAPAY_API_KEY=
# UDDOKTAPAY_API_SECRET=

# GitHub Repository Sync Configuration (Optional)
GITHUB_BRANCH=main
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
